{
    admin off
    auto_https disable_redirects
}
gateway.yanguiyuan.cn {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    redir /plugins /plugins/ 308
    handle_path /plugins/* {
        @software_upload {
            method POST
            path /v1/apps/*/assets/*
        }
        handle @software_upload {
            request_body {
                max_size 220MB
            }
            reverse_proxy registry:8787
        }
        handle {
            request_body {
                max_size 2MB
            }
            reverse_proxy registry:8787
        }
    }
    handle {
        reverse_proxy api-gateway-gateway-1:80
    }
}
